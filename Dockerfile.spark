FROM apache/spark:3.5.3-scala2.12-java17-python3-ubuntu

USER root
# libgomp1 = xgboost runtime; python3-pip ships the package manager in this image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-spark.txt /tmp/requirements-spark.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements-spark.txt

WORKDIR /app
ENV PYTHONPATH=/app/src
